{
  "name": "suncorp-claims-portal",
  "version": "3.4.1",
  "description": "Digital claims lodgement portal for Suncorp Personal Insurance brands",
  "private": true,
  "engines": {
    "node": ">=10.16.0 <13.0.0",
    "npm": ">=6.9.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:aami": "ng serve --configuration=aami --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:uat": "ng build --configuration=uat",
    "build:prod": "ng build --configuration production --aot --build-optimizer",
    "test": "ng test --watch=false --code-coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test",
    "sonar": "sonar-scanner",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@angular/animations": "16.2.12",
    "@angular/cdk": "16.2.14",
    "@angular/common": "16.2.12",
    "@angular/compiler": "16.2.12",
    "@angular/core": "16.2.12",
    "@angular/forms": "16.2.12",
    "@angular/material": "16.2.14",
    "@angular/platform-browser": "16.2.12",
    "@angular/platform-browser-dynamic": "16.2.12",
    "@angular/router": "16.2.12",
    "core-js": "2.6.9",
    "rxjs": "^7.5.7",
    "tslib": "^2.0.0",
    "zone.js": "~0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~16.2.16",
    "@angular-eslint/builder": "16.3.1",
    "@angular-eslint/eslint-plugin": "16.3.1",
    "@angular-eslint/eslint-plugin-template": "16.3.1",
    "@angular-eslint/schematics": "16.3.1",
    "@angular-eslint/template-parser": "16.3.1",
    "@angular/cli": "16.2.16",
    "@angular/compiler-cli": "16.2.12",
    "@angular/language-service": "16.2.12",
    "@playwright/test": "^1.40.1",
    "@types/jasmine": "^3.6.11",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "eslint": "^8.39.0",
    "jasmine-core": "~3.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "karma-junit-reporter": "1.2.0",
    "sass": "1.55.0",
    "sonar-scanner": "3.1.0",
    "typescript": "^5.1.6"
  }
}
