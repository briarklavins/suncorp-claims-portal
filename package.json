{
  "name": "suncorp-claims-portal",
  "version": "3.4.1",
  "description": "Digital claims lodgement portal for Suncorp Personal Insurance brands",
  "private": true,
  "engines": {
    "node": ">=10.16.0 <13.0.0",
    "npm": ">=6.9.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:aami": "ng serve --configuration=aami --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:uat": "ng build --configuration=uat",
    "build:prod": "ng build --prod --aot --build-optimizer",
    "test": "ng test --watch=false --code-coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "sonar": "sonar-scanner"
  },
  "dependencies": {
    "@angular/animations": "9.1.13",
    "@angular/cdk": "8.2.3",
    "@angular/common": "9.1.13",
    "@angular/compiler": "9.1.13",
    "@angular/core": "9.1.13",
    "@angular/flex-layout": "8.0.0-beta.27",
    "@angular/forms": "9.1.13",
    "@angular/material": "8.2.3",
    "@angular/platform-browser": "9.1.13",
    "@angular/platform-browser-dynamic": "9.1.13",
    "@angular/router": "9.1.13",
    "classlist.js": "^1.1.20150312",
    "core-js": "2.6.9",
    "hammerjs": "2.0.8",
    "moment": "2.24.0",
    "ngx-currency": "1.5.2",
    "rxjs": "6.6.7",
    "rxjs-compat": "6.4.0",
    "tslib": "^1.10.0",
    "web-animations-js": "^2.3.2",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.901.15",
    "@angular/cli": "9.1.15",
    "@angular/compiler-cli": "9.1.13",
    "@angular/language-service": "9.1.13",
    "@types/jasmine": "3.3.16",
    "@types/jasminewd2": "2.0.6",
    "@types/node": "^12.11.1",
    "codelyzer": "^5.1.2",
    "jasmine-core": "3.4.0",
    "jasmine-spec-reporter": "4.2.1",
    "karma": "4.1.0",
    "karma-chrome-launcher": "2.2.0",
    "karma-coverage-istanbul-reporter": "2.0.5",
    "karma-jasmine": "2.0.1",
    "karma-jasmine-html-reporter": "1.4.0",
    "karma-junit-reporter": "1.2.0",
    "node-sass": "4.12.0",
    "protractor": "5.4.2",
    "sonar-scanner": "3.1.0",
    "ts-node": "8.3.0",
    "tslint": "5.15.0",
    "typescript": "3.8.3"
  }
}
