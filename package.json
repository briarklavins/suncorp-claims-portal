{
  "name": "suncorp-claims-portal",
  "version": "3.4.1",
  "description": "Digital claims lodgement portal for Suncorp Personal Insurance brands",
  "private": true,
  "engines": {
    "node": ">=10.16.0 <13.0.0",
    "npm": ">=6.9.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:aami": "ng serve --configuration=aami --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:uat": "ng build --configuration=uat",
    "build:prod": "ng build --configuration production --aot --build-optimizer",
    "test": "ng test --watch=false --code-coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test",
    "sonar": "sonar-scanner",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@angular/animations": "15.2.10",
    "@angular/cdk": "15.2.9",
    "@angular/common": "15.2.10",
    "@angular/compiler": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "15.2.10",
    "@angular/material": "15.2.9",
    "@angular/platform-browser": "15.2.10",
    "@angular/platform-browser-dynamic": "15.2.10",
    "@angular/router": "15.2.10",
    "core-js": "2.6.9",
    "moment": "2.24.0",
    "ngx-currency": "1.5.2",
    "rxjs": "^7.5.7",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~15.2.11",
    "@angular-eslint/builder": "15.2.1",
    "@angular-eslint/eslint-plugin": "15.2.1",
    "@angular-eslint/eslint-plugin-template": "15.2.1",
    "@angular-eslint/schematics": "15.2.1",
    "@angular-eslint/template-parser": "15.2.1",
    "@angular/cli": "15.2.11",
    "@angular/compiler-cli": "15.2.10",
    "@angular/language-service": "15.2.10",
    "@playwright/test": "^1.40.1",
    "@types/jasmine": "^3.6.11",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "eslint": "^8.28.0",
    "jasmine-core": "~3.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "karma-junit-reporter": "1.2.0",
    "sass": "1.55.0",
    "sonar-scanner": "3.1.0",
    "typescript": "^4.8.4"
  }
}
