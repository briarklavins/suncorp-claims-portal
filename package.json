{
  "name": "suncorp-claims-portal",
  "version": "3.4.1",
  "description": "Digital claims lodgement portal for Suncorp Personal Insurance brands",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <21.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:aami": "ng serve --configuration=aami --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:uat": "ng build --configuration=uat",
    "build:prod": "ng build --configuration production",
    "test": "ng test --watch=false --code-coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "sonar": "sonar-scanner"
  },
  "dependencies": {
    "@angular/animations": "10.2.5",
    "@angular/cdk": "10.2.7",
    "@angular/common": "10.2.5",
    "@angular/compiler": "10.2.5",
    "@angular/core": "10.2.5",
    "@angular/flex-layout": "10.0.0-beta.32",
    "@angular/forms": "10.2.5",
    "@angular/material": "10.2.7",
    "@angular/platform-browser": "10.2.5",
    "@angular/platform-browser-dynamic": "10.2.5",
    "@angular/router": "10.2.5",
    "classlist.js": "1.1.20150312",
    "core-js": "2.6.9",
    "moment": "2.24.0",
    "ngx-currency": "1.5.2",
    "rxjs": "6.6.7",
    "rxjs-compat": "6.4.0",
    "tslib": "^2.0.0",
    "web-animations-js": "2.3.2",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.1002.4",
    "@angular/cli": "10.2.4",
    "@angular/compiler-cli": "10.2.5",
    "@angular/language-service": "10.2.5",
    "@types/jasmine": "3.3.16",
    "@types/jasminewd2": "2.0.6",
    "@types/node": "^12.11.1",
    "codelyzer": "^5.1.2",
    "jasmine-core": "~3.5.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~5.0.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "karma-junit-reporter": "1.2.0",
    "node-sass": "4.12.0",
    "protractor": "~7.0.0",
    "sonar-scanner": "3.1.0",
    "ts-node": "8.3.0",
    "tslint": "~6.1.0",
    "typescript": "4.0.8"
  }
}
